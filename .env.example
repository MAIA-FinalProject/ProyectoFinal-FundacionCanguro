# Copia este archivo a .env. Descomenta solo los valores que quieras cambiar.
# En Docker Compose, estas rutas y direcciones son las que ven los contenedores.
# MODEL_DIR=/app/modelos
# API_BASE_URL=http://api:8000
# DASHBOARD_REPORTS_DIR=/app/reports
#
# Para ejecutar sin Docker, los valores por defecto son la carpeta modelos/
# de este repositorio, http://localhost:8000 y la carpeta reports/.
